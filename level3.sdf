<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="level3">

    <!-- ============================================================
         SLAM MAZE ROOM
         Design notes (why it's built this way):
         - Outer room: 12m x 10m rectangle.
         - Interior walls are deliberately IRREGULAR: different lengths,
           different corridor widths (1.2m - 2.2m), and one junction is
           rotated off the 90-degree grid. Perfectly repeating/symmetric
           corridors are a classic cause of SLAM scan-matching ambiguity
           (perceptual aliasing), so nothing here repeats exactly.
         - Distinct landmark objects (cylinder pillars, an angled box,
           a small stub wall) are scattered at asymmetric locations so
           the robot always has a unique local signature to localize
           against, even in open areas.
         - Everything is static (no physics needed to move these).
         ============================================================ -->

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         Reusable wall macro pattern: every wall is its own static
         model with a box collision + visual. Pose = center of wall.
         size = (length, thickness, height)
         ============================================================ -->

    <!-- ===================== OUTER BOUNDARY ===================== -->
    <model name="wall_outer_north">
      <static>true</static>
      <pose>0 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.3 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_south">
      <static>true</static>
      <pose>0 -5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.3 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_east">
      <static>true</static>
      <pose>6 0 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.15 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_west">
      <static>true</static>
      <pose>-6 0 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.15 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== INTERIOR MAZE WALLS =====================
         Irregular lengths & varying corridor widths on purpose. -->

    <!-- Long shelf wall splitting the NW corner, leaves a 1.5m gap
         near the west wall as the first corridor -->
    <model name="wall_int_01">
      <static>true</static>
      <pose>-4.0 3.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.5 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drops down from wall_int_01, short stub, creates a dead-end nook
         (a distinctive, non-repeating feature) -->
    <model name="wall_int_02">
      <static>true</static>
      <pose>-1.35 2.6 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.9 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.9 0.15 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Central diagonal wall (off-grid on purpose) forming an angled
         junction so two corridors never look identical -->
    <model name="wall_int_03_diagonal">
      <static>true</static>
      <pose>1.3 -0.2 1.25 0 0 0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.2 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.5 0.55 0.65 1</ambient><diffuse>0.5 0.55 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Long vertical spine wall, east-central, creates a wide corridor
         on one side (2.2m) and a narrow one on the other (1.2m) -->
    <model name="wall_int_04">
      <static>true</static>
      <pose>3.5 0.5 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.5 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Short horizontal wall in SW area, offset (not centered) to
         avoid mirror symmetry with wall_int_01 -->
    <model name="wall_int_05">
      <static>true</static>
      <pose>-4.2 -2.6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.2 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.5 0.5 1</ambient><diffuse>0.6 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vertical connector wall closing off a small side room in the
         south, with an intentionally uneven doorway offset -->
    <model name="wall_int_06">
      <static>true</static>
      <pose>-2.6 -4 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.8 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.8 0.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.5 0.5 1</ambient><diffuse>0.6 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Short wall near NE corner, breaks up the otherwise open corner
         so it isn't feature-less -->
    <model name="wall_int_07">
      <static>true</static>
      <pose>4.6 3.6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Angled stub near south-east, second off-grid feature so the
         two non-90-degree corners look different from one another -->
    <model name="wall_int_08_diagonal">
      <static>true</static>
      <pose>2.4 -3.4 1.25 0 0 -0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.15 2.5</size></box></geometry>
          <material><ambient>0.5 0.55 0.65 1</ambient><diffuse>0.5 0.55 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== UNIQUE LANDMARK OBJECTS =====================
         Scattered, non-repeating shapes to give the SLAM front-end
         strong, unambiguous local features (helps loop closure too). -->

    <model name="pillar_01">
      <static>true</static>
      <pose>2.0 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.6 1</ambient><diffuse>0.55 0.35 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_02_thin">
      <static>true</static>
      <pose>4.5 -3.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="angled_box_landmark">
      <static>true</static>
      <pose>-4.3 3.7 0.4 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.35 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.35 0.8</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_landmark">
      <static>true</static>
      <pose>-5.2 -1.2 0.3 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.6 0.45 0.2 1</ambient><diffuse>0.6 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_03">
      <static>true</static>
      <pose>0.2 3.8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== END-OF-LEVEL SPHERE CLUSTER =====================
         Three spheres of different radii AND distinct colors, clustered
         at the spot the blue lock used to occupy. The camera task is now:
         look at all three, and report the color of the one with the
         largest radius.

         Placed at nearly the same depth (y ~= 2.95-3.05) and spread out
         only in x, so from a head-on viewpoint their apparent pixel size
         in the image actually tracks true size; no rock is meaningfully
         farther away than another, which was the problem with the old
         scattered layout (a closer small rock could look bigger than a
         farther large one). Still worth doing depth-normalized size
         comparison in OpenCV if you have it, but geometry alone won't
         mislead you now.

         Spacing (0.35 m center-to-center) keeps all three inside the
         OAK-D's ~69 deg horizontal FOV from a single viewpoint about
         1 m back, with no sphere occluding another. -->

    <light type="point" name="cluster_light">
      <pose>4.9 3.0 2.3 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>8</range>
        <constant>1.0</constant>
        <linear>0.15</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Medium sphere, red -->
    <model name="rock_01">
      <static>true</static>
      <pose>4.55 2.95 0.22 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Smallest sphere, green -->
    <model name="rock_02">
      <static>true</static>
      <pose>4.9 3.05 0.17 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.17</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.17</radius></sphere></geometry>
          <material>
            <ambient>0.1 0.75 0.15 1</ambient>
            <diffuse>0.1 0.75 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Largest sphere, yellow: this is the one the camera task
         should end up identifying -->
    <model name="rock_03">
      <static>true</static>
      <pose>5.25 2.95 0.28 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.28</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.28</radius></sphere></geometry>
          <material>
            <ambient>0.85 0.75 0.05 1</ambient>
            <diffuse>0.85 0.75 0.05 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== SLAM WAYPOINT / GOAL MARKERS =====================
         Visual-only (no collision) markers at a few suggested
         navigation coordinates. Rename/move/add as your assignment's
         given coordinates require; these are just placeholders so
         the student can see where "given" goal points sit in the map. -->

    <model name="waypoint_marker_A">
      <static>true</static>
      <pose>-5 4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="waypoint_marker_B">
      <static>true</static>
      <pose>5 -4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Robot spawn point: place your robot model / SDF include here,
         e.g. near the west wall in the open starting area -->
    <!--
    <include>
      <uri>model://your_robot</uri>
      <name>robot</name>
      <pose>-5 0 0.1 0 0 0</pose>
    </include>
    -->

  </world>
</sdf>
